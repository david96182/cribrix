# ---------------------------------------------------------------------------
# Cribrix configuration. Copy to `.env` and fill in your keys.
# Every variable is prefixed CRIBRIX_ and maps 1:1 onto cribrix/config.py.
# ---------------------------------------------------------------------------

# --- Ports (host side) ---
# Change these if something already occupies the defaults. They apply to
# `docker compose`, to `make seed`, and to the host-side test helpers, so a
# single edit here moves the whole stack consistently.
#   Check what is in the way:  lsof -nP -iTCP:8000 -sTCP:LISTEN
CRIBRIX_API_PORT=8000
CRIBRIX_DB_PORT=5432

# Host the API binds to. 127.0.0.1 keeps it off your LAN; use 0.0.0.0 to expose.
CRIBRIX_API_HOST=127.0.0.1

# --- Database ---
CRIBRIX_DATABASE_URL=postgresql+asyncpg://cribrix:cribrix@localhost:5432/cribrix
CRIBRIX_DB_POOL_SIZE=10
CRIBRIX_DB_MAX_OVERFLOW=5

# --- Embeddings ---
# Must match the vector(N) column dimension. Changing it requires a re-index
# (make clean-volumes && make up && make seed). 384 suits the default hashing
# embedder and small sentence encoders; 1536 for text-embedding-3-small.
CRIBRIX_EMBEDDING_DIM=384

# --- Retrieval ---
# Retrieve WIDE, then let triage narrow. Recall is retrieval's job;
# precision is the sieve's job. A tight top_k makes triage decorative.
CRIBRIX_RETRIEVAL_TOP_K=20

# --- Triage (the sieve) ---
# One Jev request per chunk asks three questions; decisions are made in code.
# Relevance: Jev's Score is the probability-weighted mean of the rubric levels
# (0..3), normalised to 0..1 -- continuous, NOT discrete steps.
#   0.33 = same topic, different entity   0.67 = partially answers   1.0 = direct
CRIBRIX_RELEVANCE_THRESHOLD=0.5
# Answer evidence (Noul): does the chunk actually STATE what was asked?
# Separates "relevant" from "answers the question". 0 disables.
CRIBRIX_EVIDENCE_THRESHOLD=0.5
# Prompt injection (Noul): chunks above this never reach the generator.
CRIBRIX_INJECTION_MAX=0.7
# Routing: Choice confidence required to skip retrieval as CHITCHAT.
CRIBRIX_CHITCHAT_MIN_CONFIDENCE=0.8
# If fewer than N chunks survive, refuse rather than generate. Guards against
# the #1 hallucination cause: an LLM asked to answer with no context.
CRIBRIX_MIN_CHUNKS_REQUIRED=1
CRIBRIX_MAX_CHUNKS_TO_LLM=8

# --- Verification ---
# atomic   = one Noul per sentence-level claim, all in ONE request (recommended)
# holistic = one Noul over the whole draft
# Either way, numbers in a claim that are absent from the evidence are caught
# in code (Jev is documented as weak at numeric comparison).
CRIBRIX_VERIFICATION_MODE=atomic
# Fraction of atomic claims that must be grounded for the answer to pass.
CRIBRIX_GROUNDEDNESS_THRESHOLD=1.0
# Jev's Noul returns the PROBABILITY a claim is supported. Grounded at or above this.
CRIBRIX_NOUL_THRESHOLD=0.5
# Verifier outage policy: false = refuse (fail-closed, safe default).
CRIBRIX_FAIL_OPEN_ON_VERIFIER_ERROR=false

# --- Jev (System 1) ---
# fake = deterministic offline client (no key needed) | live = real TypeSafe API
CRIBRIX_JEV_MODE=fake
CRIBRIX_JEV_API_KEY=
# jev-latest | jev-preview. Blank uses the SDK default.
CRIBRIX_JEV_MODEL=jev-latest
# Optional: route Jev via an AI gateway (e.g. https://openrouter.ai/api)
CRIBRIX_JEV_BASE_URL=
CRIBRIX_JEV_TIMEOUT_S=15.0
# Semaphore bound on concurrent Jev requests during triage.
CRIBRIX_JEV_MAX_CONCURRENCY=8

# --- LLM (System 2) ---
# fake | openai | anthropic | openrouter | together | groq | xai | ollama | custom
# All except 'anthropic' and 'fake' share one OpenAI-compatible client.
CRIBRIX_LLM_PROVIDER=fake
CRIBRIX_LLM_API_KEY=
# Blank falls back to the provider default (see PROVIDER_DEFAULTS in clients/llm.py)
CRIBRIX_LLM_MODEL=
# Required only when CRIBRIX_LLM_PROVIDER=custom
CRIBRIX_LLM_BASE_URL=
CRIBRIX_LLM_TIMEOUT_S=60.0
# 0.0 by default: a pipeline judged on groundedness must be reproducible.
CRIBRIX_LLM_TEMPERATURE=0.0
CRIBRIX_LLM_MAX_TOKENS=500

# --- App ---
CRIBRIX_LOG_LEVEL=INFO
CRIBRIX_LOG_JSON=true
# local | test | docker enable dev conveniences (auto schema, /admin/reset).
# Anything else -- and the code default, "production" -- disables them.
CRIBRIX_ENV=local
